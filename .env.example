# OpenFactCheck API — Environment Variables
#
# Copy this file to .env for local development.
# pydantic-settings loads .env automatically (OPENFACTCHECK_ prefix).
# Cloud environments (Lambda) use environment variables directly — no .env file needed.
#
# Local dev:   task dev:api
# Both debug and auth_bypass must be true for unauthenticated local requests.

# Server
OPENFACTCHECK_HOST=0.0.0.0
OPENFACTCHECK_PORT=8000
OPENFACTCHECK_DEBUG=true

# CORS — frontend origin(s) allowed to make requests
OPENFACTCHECK_CORS_ORIGINS=["http://localhost:3001"]

# Auth — bypass requires debug=true (both must be set)
OPENFACTCHECK_AUTH_BYPASS=true
# OPENFACTCHECK_COGNITO_REGION=us-east-1
# OPENFACTCHECK_COGNITO_USER_POOL_ID=
# OPENFACTCHECK_COGNITO_CLIENT_ID=

# Mode — "local" (SQLite, in-process execution) or "cloud" (DynamoDB, SQS)
OPENFACTCHECK_MODE=local
OPENFACTCHECK_SQLITE_PATH=~/.openfactcheck/data.db
# OPENFACTCHECK_DYNAMODB_TABLE_NAME=openfactcheck
# OPENFACTCHECK_DYNAMODB_REGION=us-east-1

# Execution
# OPENFACTCHECK_MAX_EXECUTION_TIMEOUT=600
